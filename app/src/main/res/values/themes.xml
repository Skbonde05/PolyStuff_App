<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UserApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/indigo_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/indigo_container</item>
        <item name="colorOnPrimaryContainer">@color/indigo_on_container</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/cyan_container</item>
        <item name="colorOnSecondaryContainer">@color/cyan_on_container</item>

        <!-- Surface & Background (Light Mode) -->
        <item name="android:colorBackground">@color/slate_bg</item>
        <item name="colorBackground">@color/slate_bg</item>
        <item name="colorOnBackground">@color/slate_text_primary</item>
        <item name="colorSurface">@color/slate_surface</item>
        <item name="colorOnSurface">@color/slate_text_primary</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/slate_text_muted</item>
        <item name="colorOutline">@color/slate_border</item>
        <item name="colorOutlineVariant">@color/slate_border</item>

        <!-- Window Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/slate_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/slate_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.UserApp.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.UserApp.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
</resources>