<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F7FA"
    tools:context=".Semesters">

    <!-- Navy Blue App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A2540"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/nestedScrollView">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0A2540"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#FFFFFF"
            app:title="Level 1"
            app:titleTextColor="#FFFFFF"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content + Ad container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F7FA"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:background="#F5F7FA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- Computing Essentials Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ce_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <!-- Navy Blue Icon Container -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ce"
                                android:contentDescription="Computing Essentials"
                                 />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Computing Essentials"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fundamentals of computing"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Communication Skill I Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cms1_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cms1"
                                android:contentDescription="Communication Skill I"
                                />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Communication Skill I"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Verbal &amp; written communication"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Communication Skill II Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cms2_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cms2"
                                android:contentDescription="Communication Skill II"
                                />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Communication Skill II"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Advanced communication"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Applied Mathematics I Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/m1_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/am1"
                                android:contentDescription="Applied Mathematics I"
                                />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Applied Mathematics I"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calculus &amp; algebra"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Applied Mathematics II Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/m2_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/am2"
                                android:contentDescription="Applied Mathematics II"
                                />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Applied Mathematics II"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Advanced mathematics"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Engineering Physics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/physics_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/phy"
                                android:contentDescription="Engineering Physics"
                               />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Engineering Physics"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mechanics, optics &amp; waves"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Banner Ad pinned at bottom -->
        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-8830492032016236/7956628985" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>