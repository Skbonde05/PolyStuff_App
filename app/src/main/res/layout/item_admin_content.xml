<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E1E7ED"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon + Text Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Navy Blue Icon Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardBackgroundColor="#0A2540"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/ivItemIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pdf"
                    android:contentDescription="Item icon"
                    app:tint="#FFFFFF" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAdminItemTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#0A2540"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Unit 1: Introduction to Operating Systems" />

                <TextView
                    android:id="@+id/tvAdminItemSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#5A6B7B"
                    android:textSize="13sp"
                    android:letterSpacing="0.01"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Subject: Operating System (CM3101)" />

                <TextView
                    android:id="@+id/tvAdminItemUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#0A2540"
                    android:textSize="12sp"
                    android:letterSpacing="0.01"
                    android:fontFamily="monospace"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:layout_marginTop="4dp"
                    tools:text="CDN: https://cdn.jsdelivr.net/gh/..." />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E1E7ED"
            android:layout_marginVertical="12dp" />

        <!-- Bottom Row: Edit & Delete Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditItem"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textColor="#0A2540"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="#0A2540"
                app:iconSize="18dp" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteItem"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:icon="@drawable/ic_delete"
                app:iconTint="#D32F2F"
                app:iconSize="18dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>