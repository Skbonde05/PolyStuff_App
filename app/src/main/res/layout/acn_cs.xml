                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:minHeight="88dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardBackgroundColor="#0A2540"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_pdf"
                            android:contentDescription="Unit 3"
                            app:tint="#FFFFFF" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unit 3: Transport Layer"
                            android:textColor="#0A2540"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.01"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TCP and UDP Protocols · 5 PDFs"
                            android:textColor="#5A6B7B"
                            android:textSize="13sp"
                            android:letterSpacing="0.01"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Navigate"
                        app:tint="#0A2540"
                        android:alpha="0.4" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Unit 4 Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/acn_u4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1E7ED"
                app:strokeWidth="1dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:minHeight="88dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardBackgroundColor="#0A2540"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_pdf"
                            android:contentDescription="Unit 4"
                            app:tint="#FFFFFF" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unit 4: Application Layer I"
                            android:textColor="#0A2540"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.01"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Domain Name System · 2 PDFs"
                            android:textColor="#5A6B7B"
                            android:textSize="13sp"
                            android:letterSpacing="0.01"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Navigate"
                        app:tint="#0A2540"
                        android:alpha="0.4" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Unit 5 Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/acn_u5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1E7ED"
                app:strokeWidth="1dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:minHeight="88dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardBackgroundColor="#0A2540"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_pdf"
                            android:contentDescription="Unit 5"
                            app:tint="#FFFFFF" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unit 5: Application Layer II"
                            android:textColor="#0A2540"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.01"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WWW and HTTP · 3 PDFs"
                            android:textColor="#5A6B7B"
                            android:textSize="13sp"
                            android:letterSpacing="0.01"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Navigate"
                        app:tint="#0A2540"
                        android:alpha="0.4" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Unit 6 Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/acn_u6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1E7ED"
                app:strokeWidth="1dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:minHeight="88dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        app:cardBackgroundColor="#0A2540"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
