<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F7FA"
    tools:context=".levels3">

    <!-- Navy Blue App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A2540"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/nestedScrollView">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0A2540"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#FFFFFF"
            app:title="Level 3"
            app:titleTextColor="#FFFFFF"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content + Ad container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F7FA"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:background="#F5F7FA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- Data Structure Using C Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ds_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ds"
                                android:contentDescription="Data Structure" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Data Structure Using C"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stacks, queues &amp; linked lists"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Object Oriented Programming C++ Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/oop_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/oop"
                                android:contentDescription="OOP C++" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Object Oriented Prog. C++"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Classes, objects &amp; inheritance"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Java Programming I Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/jp1_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/jp"
                                android:contentDescription="Java Programming I" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Java Programming I"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Core Java fundamentals"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Operating System Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/os_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/os"
                                android:contentDescription="Operating System" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Operating System"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Processes, memory &amp; scheduling"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Computer Hardware & Maintenance Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cphm_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cphm"
                                android:contentDescription="Computer Hardware" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comp. Hardware &amp; Maint."
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Assembly &amp; troubleshooting"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Computer Graphics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cg_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cg"
                                android:contentDescription="Computer Graphics" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Computer Graphics"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2D/3D rendering &amp; transforms"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Computer Network Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cn_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cn"
                                android:contentDescription="Computer Network" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Computer Network"
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Protocols, TCP/IP &amp; routing"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Professional Development Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pdtmp_cs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E1E7ED"
                    app:strokeWidth="1dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:minHeight="88dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardBackgroundColor="#0A2540"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/dtmp"
                                android:contentDescription="Professional Development" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prof. Dev. &amp; Tech. Maint."
                                android:textColor="#0A2540"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.01"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Career skills &amp; maintenance"
                                android:textColor="#5A6B7B"
                                android:textSize="13sp"
                                android:letterSpacing="0.01"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:ellipsize="end" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Navigate"
                            app:tint="#0A2540"
                            android:alpha="0.4" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Banner Ad pinned at bottom -->
        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-8830492032016236/7956628985" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>